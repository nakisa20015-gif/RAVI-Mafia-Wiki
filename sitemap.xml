---
layout: null
permalink: /sitemap.xml
---
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign indexable_pages = site.pages | where: "layout", "default" %}
{% for entry in indexable_pages %}
{% unless entry.robots contains "noindex" %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ entry.url | xml_escape }}</loc>
  </url>
{% endunless %}
{% endfor %}
</urlset>
